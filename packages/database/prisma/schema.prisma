generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CLIENT
  PROFESSIONAL
  ADMIN
}

enum ServiceRequestStatus {
  OPEN
  IN_NEGOTIATION
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum ServiceRequestUrgency {
  URGENT
  THIS_WEEK
  FLEXIBLE
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELED
}

enum ServiceContractStatus {
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum NotificationType {
  SYSTEM
  PROPOSAL_RECEIVED
  PROPOSAL_ACCEPTED
  PROPOSAL_REJECTED
  MESSAGE_RECEIVED
  SERVICE_UPDATED
  REVIEW_RECEIVED
}

// Tipo de alvo de uma denúncia. O par (targetType, targetId) aponta para o
// registro denunciado sem relação forte — ver o comentário de ContentReport.
enum ReportTargetType {
  USER
  MESSAGE
  REVIEW
  SERVICE_REQUEST
  PORTFOLIO_ITEM
}

enum ReportReason {
  SPAM
  ASSEDIO
  CONTEUDO_SEXUAL
  VIOLENCIA
  DISCURSO_DE_ODIO
  GOLPE
  OUTRO
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum SubscriptionPlan {
  MONTHLY
  ANNUAL
}

// Estado da assinatura. ACTIVE e IN_GRACE concedem as vantagens; CANCELED mantém
// as vantagens só até currentPeriodEnd; EXPIRED não concede nada. A regra "tem
// assinatura ativa" é derivada do estado + datas, nunca de um flag no dispositivo.
enum SubscriptionStatus {
  ACTIVE
  IN_GRACE
  CANCELED
  EXPIRED
}

enum SubscriptionStore {
  GOOGLE_PLAY
  APP_STORE
  // Loja simulada do RevenueCat, usada para testar o fluxo em dev sem Google/Apple.
  TEST_STORE
}

enum CategorySuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String
  email               String               @unique
  emailVerified       Boolean              @default(false)
  username            String?              @unique
  displayUsername     String?
  passwordHash        String?
  phone               String?
  role                UserRole             @default(CLIENT)
  avatarUrl           String?
  // Suspensão por moderação: enquanto preenchida, toda rota autenticada responde
  // 403 ACCOUNT_SUSPENDED e o usuário some das listagens públicas.
  suspendedAt         DateTime?
  suspendedReason     String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sessions            Session[]
  accounts            Account[]
  clientProfile       ClientProfile?
  professionalProfile ProfessionalProfile?
  sentMessages        Message[]            @relation("MessageSender")
  notifications       Notification[]
  pushTokens          DevicePushToken[]
  reviewsWritten      Review[]             @relation("ReviewReviewer")
  reviewsReceived     Review[]             @relation("ReviewReviewed")
  blocksMade          UserBlock[]          @relation("BlocksMade")
  blocksReceived      UserBlock[]          @relation("BlocksReceived")
  reportsMade         ContentReport[]      @relation("ReportsMade")

  @@index([email])
  @@index([username])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accountId])
}

model Verification {
  id         String    @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
}

// Solicitacao de redefinicao de senha aguardando confirmacao pelo link do email.
// `id` e `confirmationTokenHash` guardam apenas hashes: o requestId vive no app
// e o token de confirmacao no email. A linha e apagada quando o resetToken e
// entregue ao app, entao o token em claro tem vida curta e uso unico.
model PasswordResetRequest {
  id                    String    @id
  email                 String
  confirmationTokenHash String    @unique
  resetToken            String
  confirmedAt           DateTime?
  expiresAt             DateTime
  createdAt             DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

model RateLimitBucket {
  id        String   @id
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model ClientProfile {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @unique @db.Uuid
  document         String?           @unique
  ratingAverage    Decimal           @default(0) @db.Decimal(3, 2)
  ratingCount      Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceRequests  ServiceRequest[]
  serviceContracts ServiceContract[]
  chats            Chat[]
}

model ProfessionalProfile {
  id                   String                      @id @default(uuid()) @db.Uuid
  userId               String                      @unique @db.Uuid
  document             String?                     @unique
  bio                  String?                     @db.Text
  // Profissão em texto livre: como o profissional se apresenta (ex.: "Especialista
  // em Energia Solar"). Apenas descritiva — a lógica da plataforma usa as categorias.
  profession           String?
  experience           Int?
  portfolioDescription String?                     @db.Text
  isAvailable          Boolean                     @default(true)
  ratingAverage        Decimal                     @default(0) @db.Decimal(3, 2)
  ratingCount          Int                         @default(0)
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  user                 User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories           ProfessionalCategory[]
  cities               ProfessionalCity[]
  proposals            Proposal[]
  serviceContracts     ServiceContract[]
  chats                Chat[]
  portfolioItems       ProfessionalPortfolioItem[]
  subscription         ProfessionalSubscription?
  certificate          ParticipationCertificate?
  categorySuggestions  CategorySuggestion[]
}

model Category {
  id              String                 @id @default(uuid()) @db.Uuid
  name            String                 @unique
  slug            String                 @unique
  description     String?                @db.Text
  isActive        Boolean                @default(true)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  professionals   ProfessionalCategory[]
  serviceRequests ServiceRequest[]

  @@index([slug])
}

model ProfessionalCategory {
  id             String              @id @default(uuid()) @db.Uuid
  professionalId String              @db.Uuid
  categoryId     String              @db.Uuid
  createdAt      DateTime            @default(now())
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  category       Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([professionalId, categoryId])
  @@index([professionalId])
  @@index([categoryId])
}

// Sugestão de nova categoria enviada pelo profissional. Fica pendente até uma
// análise administrativa manual (não vira categoria ativa automaticamente, nem
// aparece para outros usuários).
model CategorySuggestion {
  id             String                   @id @default(uuid()) @db.Uuid
  professionalId String                   @db.Uuid
  name           String
  status         CategorySuggestionStatus @default(PENDING)
  createdAt      DateTime                 @default(now())
  professional   ProfessionalProfile      @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
  @@index([status])
}

model City {
  id            String             @id @default(uuid()) @db.Uuid
  name          String
  state         String
  // Nome normalizado (sem acento, minúsculo) para busca insensível a acento/caixa.
  // Preenchido na carga; indexado para busca rápida sobre a base completa (IBGE).
  searchName    String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  professionals ProfessionalCity[]
  requests      ServiceRequest[]

  @@unique([name, state])
  @@index([searchName])
}

model ProfessionalCity {
  id             String              @id @default(uuid()) @db.Uuid
  professionalId String              @db.Uuid
  cityId         String              @db.Uuid
  createdAt      DateTime            @default(now())
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  city           City                @relation(fields: [cityId], references: [id], onDelete: Restrict)

  @@unique([professionalId, cityId])
  @@index([professionalId])
  @@index([cityId])
}

model ServiceRequest {
  id                  String                @id @default(uuid()) @db.Uuid
  clientId            String                @db.Uuid
  categoryId          String                @db.Uuid
  cityId              String                @db.Uuid
  title               String
  description         String                @db.Text
  status              ServiceRequestStatus  @default(OPEN)
  urgency             ServiceRequestUrgency @default(FLEXIBLE)
  budgetMin           Decimal?              @db.Decimal(10, 2)
  budgetMax           Decimal?              @db.Decimal(10, 2)
  // Endereço completo só é coletado/liberado após a contratação. Na criação da
  // solicitação ficam nulos; o cliente informa apenas cidade e bairro (opcional).
  addressStreet       String?
  addressNumber       String?
  addressNeighborhood String?
  addressComplement   String?
  addressZipCode      String?
  latitude            Float?
  longitude           Float?
  // Ocultação por moderação: a solicitação some das oportunidades e do detalhe; o
  // cliente vê o aviso de remoção. Registro preservado. Nulo = visível.
  hiddenAt            DateTime?
  hiddenReason        String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  client              ClientProfile         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  category            Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  city                City                  @relation(fields: [cityId], references: [id], onDelete: Restrict)
  photos              ServiceRequestPhoto[]
  proposals           Proposal[]
  // Um contrato ativo por vez, mas o histórico guarda os cancelados: uma
  // solicitação pode ser recontratada após um cancelamento por não comparecimento.
  serviceContracts    ServiceContract[]

  @@index([clientId])
  @@index([categoryId])
  @@index([cityId])
  @@index([status])
}

model ServiceRequestPhoto {
  id               String         @id @default(uuid()) @db.Uuid
  serviceRequestId String         @db.Uuid
  url              String
  // public_id na Cloudinary, necessário para apagar o arquivo quando a foto sai.
  // Opcional: fotos anteriores a esta coluna podem não ter valor derivável da URL.
  publicId         String?
  createdAt        DateTime       @default(now())
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  @@index([serviceRequestId])
}

model Proposal {
  id               String              @id @default(uuid()) @db.Uuid
  serviceRequestId String              @db.Uuid
  professionalId   String              @db.Uuid
  price            Decimal             @db.Decimal(10, 2)
  description      String              @db.Text
  estimatedDays    Int?
  status           ProposalStatus      @default(PENDING)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  serviceRequest   ServiceRequest      @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  professional     ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  serviceContract  ServiceContract?

  @@unique([serviceRequestId, professionalId])
  @@index([serviceRequestId])
  @@index([professionalId])
  @@index([status])
}

model ServiceContract {
  id               String                @id @default(uuid()) @db.Uuid
  serviceRequestId String                @db.Uuid
  proposalId       String                @unique @db.Uuid
  clientId         String                @db.Uuid
  professionalId   String                @db.Uuid
  status           ServiceContractStatus @default(ACCEPTED)
  acceptedAt       DateTime              @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  canceledAt       DateTime?
  // Auditoria do cancelamento: quem cancelou (userId) e o motivo informado.
  canceledBy       String?               @db.Uuid
  cancelReason     String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  serviceRequest   ServiceRequest        @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  proposal         Proposal              @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  client           ClientProfile         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  professional     ProfessionalProfile   @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  reviews          Review[]

  @@index([serviceRequestId])
  @@index([clientId])
  @@index([professionalId])
  @@index([status])
}

model Review {
  id                String          @id @default(uuid()) @db.Uuid
  serviceContractId String          @db.Uuid
  reviewerId        String          @db.Uuid
  reviewedId        String          @db.Uuid
  rating            Int
  comment           String?         @db.Text
  // Ocultação por moderação: a avaliação some das listagens e deixa de contar na
  // nota média. Registro preservado para auditoria. Nulo = visível.
  hiddenAt          DateTime?
  hiddenReason      String?
  createdAt         DateTime        @default(now())
  serviceContract   ServiceContract @relation(fields: [serviceContractId], references: [id], onDelete: Cascade)
  reviewer          User            @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  reviewed          User            @relation("ReviewReviewed", fields: [reviewedId], references: [id], onDelete: Restrict)

  @@unique([serviceContractId, reviewerId, reviewedId])
  @@index([reviewerId])
  @@index([reviewedId])
}

// Conversa 1:1 entre um cliente e um profissional. É única por par e reutilizável:
// pode ser iniciada a qualquer momento (ex.: pelo perfil), independente de haver
// uma solicitação ou proposta. Todo o histórico fica preservado no mesmo registro.
model Chat {
  id             String              @id @default(uuid()) @db.Uuid
  clientId       String              @db.Uuid
  professionalId String              @db.Uuid
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  client         ClientProfile       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  messages       Message[]

  @@unique([clientId, professionalId])
  @@index([clientId])
  @@index([professionalId])
}

model Message {
  id            String    @id @default(uuid()) @db.Uuid
  chatId        String    @db.Uuid
  senderId      String    @db.Uuid
  // Legenda do anexo ou o texto da mensagem. Fica vazio quando a mensagem é só
  // uma foto — toda mensagem tem conteúdo OU anexo (validado no backend).
  content            String    @db.Text
  // Anexo de imagem (opcional). A URL é montada pelo servidor; o public_id é o
  // que permite apagar o arquivo na Cloudinary quando a mensagem é excluída.
  attachmentUrl      String?
  attachmentPublicId String?
  // Ocultação por moderação: a mensagem some da conversa para os dois lados, mas o
  // registro é preservado para auditoria. Nulo = visível.
  hiddenAt      DateTime?
  hiddenReason  String?
  readAt        DateTime?
  createdAt     DateTime  @default(now())
  chat          Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender        User      @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@index([senderId])
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  title     String
  message   String           @db.Text
  type      NotificationType @default(SYSTEM)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
}

// Token de push (Expo) por dispositivo. Um usuário pode ter vários dispositivos.
model DevicePushToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  platform  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Bloqueio entre usuários. É direcional (blocker -> blocked), mas o efeito é
// simétrico: se qualquer um dos dois bloqueou o outro, eles somem um do outro
// (listas, buscas, oportunidades e conversas) e não trocam mensagens. Só quem
// bloqueou pode desfazer. O histórico das conversas é preservado, apenas oculto.
model UserBlock {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now())
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

// Denúncia de conteúdo ou de usuário. O alvo é polimórfico (targetType + targetId)
// em vez de uma coluna por tabela: o volume não justifica multiplicar colunas e
// migrations a cada novo tipo. A existência do alvo é validada no handler antes de
// gravar. O índice único torna a denúncia repetida do mesmo alvo idempotente.
model ContentReport {
  id             String           @id @default(uuid()) @db.Uuid
  reporterId     String           @db.Uuid
  targetType     ReportTargetType
  targetId       String           @db.Uuid
  reason         ReportReason
  // Detalhe livre do denunciante (obrigatório quando o motivo é OUTRO).
  details        String?          @db.Text
  status         ReportStatus     @default(PENDING)
  createdAt      DateTime         @default(now())
  // Data e nota da decisão do operador. Nulos enquanto a denúncia está PENDING.
  resolvedAt     DateTime?
  resolutionNote String?          @db.Text
  reporter       User             @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reporterId, targetType, targetId])
  @@index([status])
  @@index([createdAt])
}

model ProfessionalPortfolioItem {
  id             String              @id @default(uuid()) @db.Uuid
  professionalId String              @db.Uuid
  title          String
  description    String?             @db.Text
  imageUrl       String
  // Ocultação por moderação: o item some de todas as leituras, mas o registro é
  // preservado para auditoria. Nulo = visível.
  hiddenAt       DateTime?
  hiddenReason   String?
  // public_id na Cloudinary, necessário para apagar o arquivo quando o item sai.
  // Opcional: itens anteriores a esta coluna podem não ter valor derivável da URL.
  publicId       String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
}

// Assinatura paga do profissional, comprada pela loja (Google Play / App Store).
// É a fonte de verdade do servidor sobre "quem tem assinatura ativa": o app nunca
// decide, só reporta. Os dados de estado/expiração vêm da verificação com a loja
// (via RevenueCat), nunca de sinal do dispositivo. 1:1 com o perfil profissional.
model ProfessionalSubscription {
  id                    String              @id @default(uuid()) @db.Uuid
  professionalId        String              @unique @db.Uuid
  plan                  SubscriptionPlan
  status                SubscriptionStatus  @default(EXPIRED)
  store                 SubscriptionStore
  storeProductId        String
  // Identificador estável da compra na loja: originalTransactionId (Apple) ou
  // purchaseToken (Google). Usado para reconciliar e restaurar sem duplicar.
  storeTransactionId    String              @unique
  // Fim do período pago atual. Enquanto o agora for anterior a esta data e o
  // estado permitir, as vantagens ficam ativas.
  currentPeriodEnd      DateTime
  // Fim do período de tolerância quando a renovação falha (grace period). Nulo
  // fora de tolerância. O prazo segue o configurado na loja/RevenueCat.
  gracePeriodEnd        DateTime?
  autoRenew             Boolean             @default(true)
  // Última vez que o servidor confirmou o estado com a loja/RevenueCat.
  lastVerifiedAt        DateTime            @default(now())
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  professional          ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  events                SubscriptionEvent[]

  @@index([status])
  @@index([currentPeriodEnd])
}

// Trilha de auditoria append-only das transições da assinatura (compra, renovação,
// cancelamento, grace period, expiração, reembolso), vindas de webhook, compra ou
// reconciliação. Guarda apenas um resumo — nunca o recibo cru/sensível.
model SubscriptionEvent {
  id             String                   @id @default(uuid()) @db.Uuid
  subscriptionId String                   @db.Uuid
  type           String
  summary        String                   @db.Text
  createdAt      DateTime                 @default(now())
  subscription   ProfessionalSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
}

// Certificado de participação do profissional. É um selo de participação/verificação
// na plataforma — NÃO uma certificação técnica ou profissional oficial. A validade
// NÃO é persistida: é derivada do status da assinatura no momento da verificação,
// para nunca ficar dessincronizada. 1:1 com o perfil profissional.
model ParticipationCertificate {
  id                 String              @id @default(uuid()) @db.Uuid
  professionalId     String              @unique @db.Uuid
  // Código único, aleatório e não sequencial, usado na verificação pública.
  code               String              @unique
  issuedAt           DateTime            @default(now())
  // Nome do profissional no momento da emissão (snapshot para exibição estável).
  holderNameSnapshot String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  professional       ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([code])
}
